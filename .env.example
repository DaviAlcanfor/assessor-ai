# LLM providers
GEMINI_API_KEY=<your_api_key>
GROQ_API_KEY=<your_api_key>

# Local development with Docker Compose
# Run: docker compose up -d
POSTGRES_URI=postgresql://assessor:assessor@localhost:5432/assessor
MONGODB_URI=mongodb://assessor:assessor@localhost:27017/assessor?authSource=admin
REDIS_URI=redis://localhost:6379/0
QDRANT_URL=http://localhost:6333

# Optional Qdrant API key for cloud instances
# QDRANT_API_KEY=

# JWT secret for API authentication (generate with: openssl rand -hex 32)
JWT_SECRET_KEY=<generate_a_strong_secret>