# O grupo do settings vira prefixo com "__" (LLM__, DATABASE__, API_KEYS__, API__, OBSERVABILITY__).
# Variável com nome errado não dá erro: ela só é ignorada. Os padrões estão em src/assessor_ai/settings/.

# --- LLM providers ---
LLM__GEMINI__API_KEY=<your_api_key>
LLM__GROQ__API_KEY=<your_api_key>
# Opcionais: sem chave o provider fica de fora das cadeias
LLM__CLAUDE__API_KEY=
# Vercel AI Gateway: GPT-6 Luna no fim das cadeias + JeV no guardrail e no roteador.
# Conta Vercel sem cartão cadastrado responde 403 em tudo (o código cai nos outros LLMs).
LLM__GATEWAY__API_KEY=
# Ajustes por provider (padrões em settings/llm.py):
# LLM__GEMINI__TIMEOUT_S=30
# LLM__GEMINI__RETRIES=0
# LLM__GROQ__TIMEOUT_S=30
# LLM__GROQ__RETRIES=1
# LLM__CLAUDE__TIMEOUT_S=60
# LLM__CLAUDE__RETRIES=1
# LLM__GATEWAY__TIMEOUT_S=45
# LLM__GATEWAY__RETRIES=1
# LLM__GATEWAY__BASE_URL=https://ai-gateway.vercel.sh/v1
# LLM__TIMEOUT_CURTO_S=15

# --- Bancos (serviços em nuvem; não há infra local) ---
DATABASE__POSTGRES_URL=postgresql://assessor:assessor@localhost:5432/assessor
DATABASE__MONGO_URL=mongodb://assessor:assessor@localhost:27017/assessor?authSource=admin
DATABASE__MONGO_COLLECTION_NAME=assessor
DATABASE__REDIS_URL=redis://localhost:6379/0
DATABASE__QDRANT_URL=http://localhost:6333
DATABASE__QDRANT_COLLECTION_NAME=faq
# Optional Qdrant API key for cloud instances
DATABASE__QDRANT_API_KEY=<your_api_key>

# --- Segredos do Assessor.AI ---
# Secret exigido no header X-Signup-Secret do POST /v1/keys — evita que qualquer um crie
# API keys sem estar de posse desse valor. Gere algo forte, ex: openssl rand -hex 32
API_KEYS__SIGNUP_SECRET=<your_signup_secret>

# --- Observabilidade dos agentes (opcional) — deixar LANGSMITH_TRACING=false para desligar ---
OBSERVABILITY__LANGSMITH_TRACING=false
OBSERVABILITY__LANGSMITH_API_KEY=<your_api_key>
OBSERVABILITY__LANGSMITH_PROJECT=assessor-ai

# --- API (todos opcionais; os padrões já cobrem execução local) ---
# local | production. Em production o Settings recusa auth desligada, cookie sem Secure e CORS "*".
# ENVIRONMENT=local
# Desliga a exigência de X-API-Key em /v1/chats (default true = exige). Temporário pro estágio
# atual do projeto — deixar false só em ambiente de teste/integração
API__KEY_AUTH_ENABLED=true
# URL pública onde a API é servida — usada só pra montar o AgentCard do A2A
API__A2A_BASE_URL=http://localhost:8000
# API__CORS_ORIGINS=["http://localhost:5173"]
# Sessão web (POST /v1/auth/session)
# API__SESSION_TTL_SECONDS=28800
# API__SESSION_COOKIE_NAME=__Host-assessor_session
# API__CSRF_COOKIE_NAME=__Host-assessor_csrf
# Cookie __Host- exige Secure — desligar só se o browser não aceitar a exceção de localhost
# como secure context (Chrome/Edge aceitam; se outro navegador rejeitar o cookie, use false)
# API__SESSION_COOKIE_SECURE=true
