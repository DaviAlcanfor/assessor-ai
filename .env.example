# LLM providers — o grupo "llm" do settings vira prefixo com "__"
LLM__GEMINI__API_KEY=<your_api_key>
LLM__GROQ__API_KEY=<your_api_key>
# Opcionais: sem chave o provider fica de fora das cadeias
LLM__CLAUDE__API_KEY=
# Vercel AI Gateway: GPT-6 Luna no fim das cadeias + JeV no guardrail e no roteador.
# Conta Vercel sem cartão cadastrado responde 403 em tudo (o código cai nos outros LLMs).
LLM__GATEWAY__API_KEY=
# Ajustes por provider (padrões em config.py):
# LLM__GEMINI__TIMEOUT_S=30
# LLM__GEMINI__RETRIES=0
# LLM__GROQ__TIMEOUT_S=30
# LLM__GROQ__RETRIES=1
# LLM__CLAUDE__TIMEOUT_S=60
# LLM__CLAUDE__RETRIES=1
# LLM__GATEWAY__TIMEOUT_S=45
# LLM__GATEWAY__RETRIES=1
# LLM__GATEWAY__BASE_URL=https://ai-gateway.vercel.sh/v1
# LLM__TIMEOUT_CURTO_S=15

# Local development with Docker Compose
# Run: docker compose up -d
POSTGRES_URL=postgresql://assessor:assessor@localhost:5432/assessor
MONGO_URL=mongodb://assessor:assessor@localhost:27017/assessor?authSource=admin
MONGO_COLLECTION_NAME=assessor
REDIS_URL=redis://localhost:6379/0
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION_NAME=faq

# Optional Qdrant API key for cloud instances
QDRANT_API_KEY=<your_api_key>

# Secret exigido no header X-Signup-Secret do POST /v1/keys — evita que qualquer um crie
# API keys sem estar de posse desse valor. Gere algo forte, ex: openssl rand -hex 32
SIGNUP_SECRET=<your_signup_secret>

# Observabilidade dos agentes (opcional) — deixar LANGSMITH_TRACING=false para desligar
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=<your_api_key>
LANGSMITH_PROJECT=assessor-ai

# Desliga a exigência de X-API-Key em /v1/chats (opcional, default true = exige). Temporário
# pro estágio atual do projeto — deixar false só em ambiente de teste/integração
API_KEY_AUTH_ENABLED=true
# URL pública onde a API é servida — usada só pra montar o AgentCard do A2A (opcional,
# default já cobre execução local)
A2A_BASE_URL=http://localhost:8000

# Sessão web (POST /v1/auth/session) — todos opcionais, os defaults já cobrem execução local.
# SESSION_TTL_SECONDS=28800
# SESSION_COOKIE_NAME=__Host-assessor_session
# CSRF_COOKIE_NAME=__Host-assessor_csrf
# Cookie __Host- exige Secure — desligar só se o browser não aceitar a exceção de localhost
# como secure context (Chrome/Edge aceitam; se outro navegador rejeitar o cookie, use false)
# SESSION_COOKIE_SECURE=true
