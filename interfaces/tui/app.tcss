Screen {
    align: center top;
}

#banner {
    width: 90%;
    max-width: 120;
    height: auto;
    margin: 1 0 0 0;
    content-align: center middle;
}

#historico {
    width: 90%;
    max-width: 120;
    padding: 1 2;
}

/* Paleta do design system da Kobana (mesma de web/src/styles/tokens.css):
   lime #d3fd54 = assistente, purple #a630da = usuário, #666666 = neutro/logs. */

Input {
    width: 90%;
    max-width: 120;
    margin: 0 0 1 0;
    border: round #d3fd54;
}

Input:focus {
    border: round #d3fd54;
}

MessageRow {
    width: 100%;
    height: auto;
    margin-bottom: 1;
}

MessageRow.usuario {
    align-horizontal: right;
}

MessageRow.assistente {
    align-horizontal: left;
}

Bubble {
    width: auto;
    max-width: 70%;
}

Pensando {
    width: 20;
    height: 3;
    margin-bottom: 1;
    border: round #666666;
}

Pensando LoadingIndicator {
    height: 1;
    color: #666666;
}

#logs {
    width: 90%;
    max-width: 120;
    height: 8;
    border: round #666666;
    color: $text-muted;
    background: $surface;
    padding: 0 1;
}
